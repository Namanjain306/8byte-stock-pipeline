# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub — only commit this example.

# ---- Alpha Vantage API ----
# Get a free key here: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY= 4W4AO1IO89TIC5HR

# Comma-separated list of stock ticker symbols to fetch
STOCK_SYMBOLS=IBM,AAPL,MSFT

# ---- Stock data Postgres database ----
STOCK_DB_NAME=stockdata
STOCK_DB_USER=stockuser
STOCK_DB_PASSWORD=stockpass

# ---- Airflow ----
AIRFLOW_UID=50000
